{
    "name": "remtys/remtysapp",
    "description": "REMTYS — Sistema de Gestión Predial y Fiscal Municipal",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-pdo_pgsql": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-fileinfo": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^1.11"
    },
    "autoload": {
        "psr-4": {
            "Remtys\\": "app/src/"
        },
        "classmap": [
            "app/services/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Remtys\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --colors=always",
        "stan": "phpstan analyse --memory-limit=512M",
        "lint": "find app public database -name '*.php' -print0 | xargs -0 -n1 php -l",
        "migrate": "php database/migrate.php up",
        "status": "php database/migrate.php status"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "platform": {
            "php": "8.1.0"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
