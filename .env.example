# ============================================================
# REMTYS — Variables de entorno (plantilla)
# Copia a .env y reemplaza cada CHANGE_ME. NUNCA versionar .env.
# Solo se listan variables que el código realmente lee.
# ============================================================

# --- Aplicación ---
APP_ENV=local
# Valores: local, development, docker, testing, staging, production
# Fuera de local/development/docker se RECHAZA un DB_PASS vacío al arrancar.
APP_URL=http://localhost:8080/remtysapp/public
# BASE_URL=/remtysapp/public
# Solo si la app se monta en otra ruta.

# Municipio/estado que se muestran y se guardan en predios
APP_MUNICIPIO="Municipio Demo"
APP_ESTADO="Estado de México"

# --- Base de datos ---
DB_HOST=db
DB_PORT=5432
DB_NAME=remtys2_db
DB_USER=remtys_app
DB_PASS=CHANGE_ME
# Generar con: openssl rand -base64 32
DB_SSLMODE=prefer
# disable | allow | prefer | require | verify-ca | verify-full

# --- Correo ---
MAIL_TRANSPORT=smtp
# smtp | log  (log = escribe el correo en storage/logs/mail.log, útil en local)
MAIL_SMTP_HOST=localhost
MAIL_SMTP_PORT=587
MAIL_SMTP_USERNAME=CHANGE_ME
MAIL_SMTP_PASSWORD=CHANGE_ME
MAIL_SMTP_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@ejemplo.com
MAIL_FROM_NAME="REMTYS Notificaciones"
MAIL_VERIFY_EXPIRES_HOURS=24
MAIL_RESEND_COOLDOWN_SECONDS=120

# --- Datos demo (solo desarrollo local) ---
# Contraseña con la que database/seeds.sql crea los usuarios demo (*@ejemplo.com).
# Se pasa a PostgreSQL vía PGOPTIONS (ver docker-compose.yml). Sin espacios.
DEMO_PASSWORD=CHANGE_ME
